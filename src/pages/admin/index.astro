---
import AdminLayout from "../../layouts/AdminLayout.astro";
import AdminEditor from "../../components/AdminEditor";
import { products } from "../../data/catalog";
---

<AdminLayout title="پیش‌نمایش ویرایش محصولات">
  <div class="admin-heading">
    <p class="eyebrow">کارگاه مجموعه / دادهٔ نمونه</p>
    <h1>یک تغییر، یک نگاه تازه</h1>
    <p>نام، توضیح، قیمت و موجودی محصولات را در یک پیش‌نمایش محلی امتحان کن.</p>
  </div>
  <AdminEditor seedProducts={products} client:load />
  <noscript>
    <p class="preview-notice">
      برای امتحان ویرایشگر محلی، جاوااسکریپت مرورگر را فعال کن.{" "}
      <a href="/collections/">دیدن کاتالوگ فروشگاه</a>
    </p>
  </noscript>
</AdminLayout>
