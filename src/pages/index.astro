---
import StoreLayout from "../layouts/StoreLayout.astro";
import ProductCard from "../components/ProductCard.astro";
import CollectionCard from "../components/CollectionCard.astro";
import CatalogImage from "../components/CatalogImage.astro";
import Icon from "../components/Icon.astro";
import { homeCollections, products, realProducts } from "../data/catalog";

const shark = realProducts.find(
  (product) => product.slug === "shark-wearable-blanket",
);
const madrid = realProducts.find(
  (product) => product.slug === "real-madrid-white-shirt",
);
if (!shark || !madrid)
  throw new Error("The home page source products are missing");
const blankets = realProducts.filter(
  (product) => product.category === "پتو تنپوش",
);
const sports = realProducts.filter((product) => product.category === "ورزشی");
const everyday = products.filter((product) =>
  ["sh-101", "sh-102"].includes(product.id),
);
---

<StoreLayout>
  <section class="hero shavandi-hero" aria-labelledby="hero-heading">
    <div class="hero-copy">
      <p class="eyebrow">شواندی استور + شواندی اسپرت</p>
      <h1 id="hero-heading">
        از خانه تا
        <br />
        روزِ بازی.
      </h1>
      <p class="hero-description">
        تنپوش‌های کوسه‌ای و لباس‌های فوتبال،
        <br />
        حالا در یک جای مشترک.
      </p>
      <a class="primary-link" href="/collections/wearable-blankets/">
        دیدن پتوهای تنپوش <Icon name="arrow-left" />
      </a>
      <a class="hero-sport-link" href="/collections/football/">
        <CatalogImage image={madrid.colorways[0].images[0]} sizes="100px" />
        <span>
          <span class="eyebrow">آن‌طرفِ سلیقهٔ تو</span>
          <strong>فوتبال و ورزش</strong>
          <span>پیراهن‌ها و ست‌های شواندی اسپرت ←</span>
        </span>
      </a>
    </div>
    <a
      class="hero-photo"
      href={`/products/${shark.slug}/`}
      aria-label="دیدن پتو کوسه‌ای"
    >
      <CatalogImage
        image={shark.colorways[0].images[0]}
        sizes="(max-width: 540px) 100vw, 54vw"
        eager
      />
      <span class="hero-photo-label">پتو کوسه‌ای · عکس واقعی شواندی استور</span>
    </a>
  </section>
  <div class="brand-line page-width">
    <p>چهار مسیر، یک شواندی.</p>
    <span>تنپوش‌های خانگی</span>
    <span>فوتبال و ورزش</span>
    <span>پوشاک زنانه و مردانه</span>
  </div>
  <section
    class="home-collections page-width"
    aria-labelledby="collections-heading"
  >
    <div class="section-heading">
      <div>
        <p class="eyebrow">از اینجا شروع کن</p>
        <h2 id="collections-heading">حال‌وهوای تو کدام است؟</h2>
      </div>
    </div>
    <div class="collection-grid">
      {homeCollections.map((collection) => (
        <CollectionCard collection={collection} />
      ))}
    </div>
  </section>
  <section
    class="section-space page-width"
    id="new-arrivals"
    aria-labelledby="cozy-heading"
  >
    <div class="section-heading">
      <div>
        <p class="eyebrow">از شواندی استور</p>
        <h2 id="cozy-heading">برای وقتِ خانه</h2>
      </div>
      <a class="text-link" href="/collections/wearable-blankets/">
        همهٔ تنپوش‌ها <Icon name="arrow-left" />
      </a>
    </div>
    <div class="product-grid">
      {blankets.map((product) => (
        <ProductCard product={product} />
      ))}
    </div>
    <p class="catalog-disclaimer">
      عکس، نام و قیمت از منبع، بررسی‌شده در ۱۱ آبان ۱۴۰۵. موجودی و تسویه
      نمایشی‌اند؛ اندازهٔ تأییدشده در جزئیات هر محصول آمده است.
    </p>
  </section>
  <section class="sports-section section-space" aria-labelledby="sport-heading">
    <div class="page-width">
      <div class="section-heading">
        <div>
          <p class="eyebrow">از شواندی اسپرت</p>
          <h2 id="sport-heading">به رنگِ تیم تو</h2>
        </div>
        <a class="text-link" href="/collections/football/">
          دیدن مجموعهٔ ورزشی <Icon name="arrow-left" />
        </a>
      </div>
      <p class="section-context">
        رئال مادرید، فرانسه، پرتغال و آرژانتین. نسخهٔ هواداری تأیید نشده؛ عنوان
        «پلیری» فرانسه از نام منبع است.
      </p>
      <div class="product-grid">
        {sports.map((product) => (
          <ProductCard product={product} />
        ))}
      </div>
      <p class="catalog-disclaimer">
        قیمت‌های منبع ثبت شده‌اند؛ موجودی، سبد و تسویه در این پیش‌نمایش
        نمونه‌اند.
      </p>
    </div>
  </section>
  <section
    class="section-space page-width everyday-preview"
    aria-labelledby="everyday-heading"
  >
    <div class="section-heading">
      <div>
        <p class="eyebrow">بخش موقتِ پیش‌نمایش</p>
        <h2 id="everyday-heading">انتخاب‌های روزمره</h2>
      </div>
      <a class="text-link" href="/collections/women/">
        پوشاک زنانه <Icon name="arrow-left" />
      </a>
    </div>
    <p class="section-context">
      این دو محصول با عکس‌های موقت Unsplash نمایش داده می‌شوند. نام، قیمت و همهٔ
      مشخصات آن‌ها نمونه‌اند.
    </p>
    <div class="product-grid temporary-grid">
      {everyday.map((product) => (
        <ProductCard product={product} />
      ))}
    </div>
  </section>
  <section class="story-section page-width" aria-labelledby="story-heading">
    <p class="eyebrow">دربارهٔ این شواندی</p>
    <h2 id="story-heading">
      سلیقه‌های مختلف،
      <br />
      کنار هم.
    </h2>
    <div>
      <p>
        از تنپوش‌های خانگی تا پیراهن تیم محبوبت. این پیش‌نمایش مسیر تازهٔ شواندی
        را نشان می‌دهد؛ با منبع روشن برای عکس و قیمت و برچسب مشخص برای بخش‌های
        موقت.
      </p>
      <a class="text-link" href="/about/">
        بیشتر دربارهٔ پیش‌نمایش <Icon name="arrow-left" />
      </a>
    </div>
  </section>
</StoreLayout>
