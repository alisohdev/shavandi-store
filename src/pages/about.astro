---
import StoreLayout from "../layouts/StoreLayout.astro";
import Icon from "../components/Icon.astro";
import CatalogImage from "../components/CatalogImage.astro";
import { realProducts } from "../data/catalog";
const shark = realProducts.find(
  (product) => product.slug === "shark-wearable-blanket",
);
if (!shark) throw new Error("Shark source product is missing");
---

<StoreLayout title="دربارهٔ شواندی | خانه، ورزش، هر روز">
  <div class="page-width about-page">
    <div class="about-hero">
      <div>
        <p class="eyebrow">یک شواندی، چند حال‌وهوا</p>
        <h1>
          از وقتِ خانه
          <br />
          تا روزِ بازی.
        </h1>
        <p>
          این پیش‌نمایش، تنپوش‌های شواندی استور و لباس‌های فوتبال شواندی اسپرت
          را کنار هم می‌آورد. برای پوشاک زنانه و مردانه هم جای مشخصی در همین
          تجربه در نظر گرفته شده است.
        </p>
      </div>
      <CatalogImage
        image={shark.colorways[0].images[0]}
        sizes="(max-width: 540px) 92vw, 45vw"
        eager
      />
    </div>
    <div class="prose-block">
      <h2>عکس و اطلاعات با منبع روشن</h2>
      <p>
        عکس، نام و قیمت چهار تنپوش از شواندی استور و چهار محصول ورزشی از شواندی
        اسپرت، در ۱۱ آبان ۱۴۰۵ از صفحهٔ محصول ثبت شده‌اند. اندازه‌ها و
        ویژگی‌هایی که در منبع آمده‌اند، در جزئیات هر محصول مشخص‌اند؛ جنس، روش
        نگهداری و موجودی واقعی تأیید نشده‌اند.
      </p>
      <p>
        نسخهٔ هواداری لباس‌های فوتبال تأیید نشده است. عبارت «پلیری» برای کیت
        فرانسه از نام محصول در منبع آمده؛ این عبارت به معنای تأیید فصل یا مجوز
        رسمی نیست.
      </p>
      <h2>بخش‌هایی که هنوز موقت‌اند</h2>
      <p>
        پوشاک زنانه با عکس‌های موقت Unsplash و محصولات نمونه نمایش داده می‌شود و
        موجودی واقعی شواندی نیست. دستهٔ مردانه فعلاً یک تصویرسازی موقت و صفحهٔ
        بدون محصول دارد؛ عکس پوشاک زنانه به‌عنوان مردانه استفاده نشده است.
      </p>
      <h2 id="preview">دربارهٔ این پیش‌نمایش</h2>
      <p>
        قیمت‌های ثبت‌شده از منبع با برچسب و تاریخ مشخص‌اند؛ قیمت محصولات موقت
        نمونه است. موجودی، سبد، هزینهٔ ارسال و تسویه برای تمرین مسیر خرید هستند.
        در این نسخه سفارش، پرداخت و پیامک واقعی انجام نمی‌شود.
      </p>
      <p>
        فقط انتخاب کالا و تعداد در مرورگر ذخیره می‌شود. اطلاعات گیرنده ذخیره یا
        ارسال نمی‌شود و با ترک صفحه از دست می‌رود.
      </p>
      <p>
        در پیش‌نمایش مدیریت می‌توانی نام، توضیح، قیمت و موجودی نمایشی را ویرایش
        کنی. تغییر نام، توضیح یا قیمت، برچسب اطلاعات را به «ویرایش محلی» تبدیل
        می‌کند. تغییرات فقط در همان صفحه‌اند و با تازه‌کردن آن پاک می‌شوند.
      </p>
      <a class="text-link" href="/collections/">
        دیدن مجموعه‌ها <Icon name="arrow-left" />
      </a>
    </div>
  </div>
</StoreLayout>
