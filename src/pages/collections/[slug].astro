---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import StoreLayout from "../../layouts/StoreLayout.astro";
import ProductCard from "../../components/ProductCard.astro";
import { collections, products } from "../../data/catalog";
export const getStaticPaths = (() =>
  collections.map((collection) => ({
    params: { slug: collection.slug },
    props: { collection },
  }))) satisfies GetStaticPaths;
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { collection } = Astro.props;
const selectedProducts = products.filter((product) =>
  collection.productIds.includes(product.id),
);
---

<StoreLayout
  title={`${collection.name} | شواندی`}
  description={collection.description}
>
  <div class="page-width catalog-page">
    <nav class="breadcrumbs" aria-label="مسیر صفحه">
      <a href="/">شواندی</a>
      <span aria-hidden="true">/</span>
      <a href="/collections/">مجموعه‌ها</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{collection.name}</span>
    </nav>
    <div class="collection-intro">
      <div class="page-heading">
        <p class="eyebrow">{collection.eyebrow}</p>
        <h1>{collection.name}</h1>
        <p>{collection.description}</p>
      </div>
      <img
        src={collection.image}
        alt={collection.imageAlt}
        width="1000"
        height="700"
      />
    </div>
    <nav class="collection-nav" aria-label="مجموعه‌ها">
      <a href="/collections/">همهٔ انتخاب‌ها</a>
      {collections.map((item) => (
        <a
          href={`/collections/${item.slug}/`}
          aria-current={item.slug === collection.slug ? "page" : undefined}
        >
          {item.name}
        </a>
      ))}
    </nav>
    <div class="catalog-count">
      <span>
        {new Intl.NumberFormat("fa-IR").format(selectedProducts.length)} انتخاب
      </span>
      <span>قیمت و موجودی نمونه</span>
    </div>
    <div class="product-grid">
      {selectedProducts.map((product) => (
        <ProductCard product={product} />
      ))}
    </div>
  </div>
</StoreLayout>
