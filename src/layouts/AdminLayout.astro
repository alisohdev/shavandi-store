---
import "@fontsource/vazirmatn/400.css";
import "@fontsource/vazirmatn/500.css";
import "@fontsource/vazirmatn/600.css";
import "../styles/global.css";
import "../styles/shavandi.css";
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <meta
      name="description"
      content="فضای امن مدیریت کاتالوگ شواندی. اطلاعات پس از ورود مدیر از سرور دریافت می‌شود."
    />
    <link rel="icon" href="/favicon.svg" />
    <title>{title} | شواندی</title>
  </head>
  <body class="admin-body">
    <a class="skip-link" href="#main-content">
      رفتن به محتوای اصلی
    </a>
    <div class="admin-layout">
      <aside class="admin-sidebar">
        <a class="wordmark" href="/" aria-label="بازگشت به فروشگاه شواندی">
          <span lang="en" dir="ltr">
            SHAVANDI.
          </span>
        </a>
        <p>مدیریت کاتالوگ</p>
        <nav aria-label="منوی مدیریت">
          <a href="/admin/" aria-current="page">
            محصولات
          </a>
          <a href="#admin-categories-heading">دسته‌بندی‌ها</a>
          <a href="/">بازگشت به فروشگاه ↗</a>
        </nav>
        <div class="admin-sidebar-note">
          مدیریت کاتالوگ
          <br />
          اطلاعات پس از ورود دریافت می‌شوند.
        </div>
      </aside>
      <main id="main-content" class="admin-main">
        <div class="admin-topbar">
          <span>فضای مدیریت شواندی</span>
          <span class="admin-badge">مدیریت کاتالوگ</span>
        </div>
        <slot />
      </main>
    </div>
  </body>
</html>
