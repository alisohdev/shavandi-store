---
interface Props {
  name: "arrow-left" | "arrow-up-left" | "menu" | "chevron";
  class?: string;
}
const { name, class: className } = Astro.props;
const paths = {
  "arrow-left": "M19 12H5m7 7-7-7 7-7",
  "arrow-up-left": "M17 17 7 7m0 10V7h10",
  menu: "M4 7h16M4 12h16M4 17h16",
  chevron: "m6 9 6 6 6-6",
};
---

<svg
  class={className}
  width="20"
  height="20"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={paths[name]} />
</svg>
