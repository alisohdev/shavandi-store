---
import {
  availableSizes,
  formatPrice,
  isAvailable,
  priceLabel,
  provenanceLabel,
  type Product,
} from "../data/catalog";
import CatalogImage from "./CatalogImage.astro";
interface Props {
  product: Product;
}
const { product } = Astro.props;
const firstColor = product.colorways[0];
const image = firstColor.images[0];
const available = isAvailable(product);
---

<article class="product-card" data-provenance={product.provenance.kind}>
  <a
    class="product-photo"
    href={`/products/${product.slug}/`}
    aria-label={`مشاهدهٔ ${product.name}`}
  >
    <CatalogImage
      image={image}
      sizes="(max-width: 540px) 46vw, (max-width: 900px) 45vw, 23vw"
    />
    {(!available || product.tag === "new") && (
      <span class:list={["product-tag", { "product-tag-muted": !available }]}>
        {available ? "تازه" : "ناموجود"}
      </span>
    )}
    <span class="photo-action">
      دیدن جزئیات <span aria-hidden="true">↖</span>
    </span>
  </a>
  <p
    class:list={[
      "product-provenance",
      { "is-temporary": product.provenance.kind === "temporary" },
    ]}
  >
    {provenanceLabel(product.provenance)}
  </p>
  <div class="product-meta">
    <div>
      <p class="product-category">{product.category}</p>
      <h3>
        <a href={`/products/${product.slug}/`}>{product.name}</a>
      </h3>
    </div>
    <span
      class="color-dots"
      aria-label={`رنگ‌ها: ${product.colorways.map((colorway) => colorway.label).join("، ")}`}
    >
      {product.colorways.map((colorway) => (
        <span
          style={{ backgroundColor: colorway.swatch }}
          title={colorway.label}
        />
      ))}
    </span>
  </div>
  <p class="product-price">
    <span>{formatPrice(product.priceToman)}</span>
    <span class="currency">تومان</span>
  </p>
  <p class="price-provenance">{priceLabel(product.provenance)}</p>
  <p class="product-sizes">
    {available ? (
      <>
        <span>موجودی نمایشی · </span>
        <bdi>{availableSizes(product).join(" · ")}</bdi>
      </>
    ) : (
      "ناموجود در دادهٔ نمونه"
    )}
  </p>
</article>
