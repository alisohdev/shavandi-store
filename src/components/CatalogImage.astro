---
import type { ProductImage } from "../data/catalog";
interface Props {
  image: ProductImage;
  sizes: string;
  eager?: boolean;
  class?: string;
}
const { image, sizes, eager = false, class: className } = Astro.props;
---

<img
  class={className}
  src={image.src}
  srcset={image.srcSet}
  sizes={image.srcSet ? sizes : undefined}
  alt={image.alt}
  width={image.width}
  height={image.height}
  loading={eager ? "eager" : "lazy"}
  fetchpriority={eager ? "high" : undefined}
  decoding="async"
  style={{ objectPosition: image.position, objectFit: image.fit }}
/>
