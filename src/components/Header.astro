---
import Icon from "./Icon.astro";
const links = [
  { href: "/collections/wearable-blankets/", label: "تنپوش‌ها" },
  { href: "/collections/football/", label: "فوتبال و ورزش" },
  { href: "/collections/", label: "همهٔ مجموعه‌ها" },
  { href: "/about/", label: "دربارهٔ شواندی" },
];
---

<div class="demo-bar">
  پیش‌نمایش شواندی <span aria-hidden="true">·</span> قیمت منبع مشخص است؛ موجودی
  و تسویه نمایشی‌اند
</div>
<header class="site-header">
  <div class="header-inner page-width">
    <nav class="desktop-nav" aria-label="منوی اصلی">
      {links.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>
    <a class="wordmark" href="/" aria-label="شواندی، صفحهٔ اصلی">
      <span lang="en" dir="ltr">
        SHAVANDI<span class="wordmark-dot">.</span>
      </span>
      <span class="wordmark-persian">شواندی</span>
    </a>
    <div class="header-edition">
      <div class="header-shop-links">
        <a class="header-account-link" href="/login/">
          ورود / حساب
        </a>
        <a class="header-cart-link" href="/cart/">
          سبد خرید ↖
        </a>
      </div>
      <span class="edition-caption">خانه، ورزش، هر روز</span>
      <span lang="en" dir="ltr">
        AUTUMN / 2026
      </span>
    </div>
    <details class="mobile-menu">
      <summary>
        <Icon name="menu" />
        <span>منو</span>
      </summary>
      <nav aria-label="منوی موبایل">
        <a href="/login/">
          ورود / حساب <Icon name="arrow-left" />
        </a>
        {links.map((link) => (
          <a href={link.href}>
            {link.label}
            <Icon name="arrow-left" />
          </a>
        ))}
      </nav>
    </details>
  </div>
</header>
<script>
  const menu = document.querySelector<HTMLDetailsElement>(".mobile-menu");
  menu?.addEventListener("click", (event) => {
    if (event.target instanceof Element && event.target.closest("a"))
      menu.open = false;
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menu?.open) {
      menu.open = false;
      menu.querySelector("summary")?.focus();
    }
  });
</script>
