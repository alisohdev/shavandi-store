---
import type { Collection } from "../data/catalog";
import CatalogImage from "./CatalogImage.astro";
import Icon from "./Icon.astro";
interface Props {
  collection: Collection;
}
const { collection } = Astro.props;
---

<a class="collection-card" href={`/collections/${collection.slug}/`}>
  <div class="collection-photo">
    <CatalogImage
      image={collection.image}
      sizes="(max-width: 540px) 45vw, (max-width: 900px) 45vw, 22vw"
    />
  </div>
  <div class="collection-caption">
    <div>
      <p>{collection.eyebrow}</p>
      <h3>{collection.name}</h3>
    </div>
    <span class="collection-arrow">
      <Icon name="arrow-up-left" />
    </span>
  </div>
  <p class="collection-note">{collection.note}</p>
</a>
