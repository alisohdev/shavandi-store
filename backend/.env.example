HTTP_ADDR=127.0.0.1:8080
DATABASE_URL=
# Local product image files are stored outside the repository by default.
PRODUCT_IMAGE_DIR=
TEST_DATABASE_URL=
DATABASE_MIN_CONNS=0
DATABASE_MAX_CONNS=8
APP_ENV=development
# Generate with crypto/rand or an OS cryptographic RNG; base64 encoding of at least 32 random bytes.
AUTH_SECRET=
AUTH_ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321
# false is allowed only with APP_ENV=development. Production always requires Secure cookies.
AUTH_COOKIE_SECURE=false

# SMS: unavailable (default), iranpayamak, or melipayamak.
SMS_PROVIDER=unavailable
# Storefront hostname; approve the provider template for THIS store before enabling.
OTP_SMS_DOMAIN=
SMS_TEMPLATE_WEBOTP_APPROVED=false
IRANPAYAMAK_API_KEY=
IRANPAYAMAK_PATTERN_CODE=
IRANPAYAMAK_SENDER_LINE=
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_API_KEY=
MELIPAYAMAK_PASSWORD=
MELIPAYAMAK_PATTERN_ID=
